# Copy to .env (scripts/deploy-vps.sh does this for you and generates the password).
# .env is git-ignored; never commit real values.

# Public hostname; needs a DNS A record pointing at this server.
DOMAIN=consultflow.zsz13.com

# Let's Encrypt account email for expiry notices (optional; empty registers without email).
LETSENCRYPT_EMAIL=

# 1 = use the Let's Encrypt staging CA (untrusted test certificates, no rate limits).
LETSENCRYPT_STAGING=0

# PostgreSQL password. Use letters and digits only (it is embedded in a connection URL).
# Set once: changing it later does not change the password of an existing database volume.
POSTGRES_PASSWORD=change-me
